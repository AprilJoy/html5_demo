# DeepSeek
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 群机器人 Webhook（附加题）：钉钉/企微通用，按 URL 自动识别渠道
# 钉钉示例：https://oapi.dingtalk.com/robot/send?access_token=xxx
# 企微示例：https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx
ROBOT_WEBHOOK_URL=

# 钉钉机器人「关键词」安全设置的关键词（必填，否则报「关键词不匹配」）。
# 查看路径：钉钉群 → 群设置 → 智能群助手 → 找到该机器人 → 安全设置 → 关键词
# 支持填多个（逗号分隔），消息会同时包含，命中任意一个即可通过。
ROBOT_KEYWORD=

# 钉钉机器人「加签」密钥（SEC 开头；安全设置为关键词时留空，企微忽略此项）
DINGTALK_SECRET=

# 可选：Prompt 热更新（覆盖 server/prompts.js 中的默认值）
# PROMPT_SYSTEM=
# PROMPT_STYLE_GOOGLE=
# PROMPT_STYLE_XHS=

# 限流：每 IP 每小时最大生成次数
RATE_LIMIT_PER_HOUR=10
